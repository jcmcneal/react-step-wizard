{
  "name": "react-step-wizard",
  "version": "6.0.0-beta.0",
  "description": "A modern flexible step wizard component built for React",
  "main": "./dist/index.cjs",
  "scripts": {
    "start": "npm run app:dev",
    "app:dev": "node scripts/dev.mjs",
    "app:build": "vite build --config app/vite.config.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src app tests scripts *.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run app:build && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test:next": "node scripts/check-next.mjs",
    "app:preview": "vite preview --config app/vite.config.ts",
    "app:dev:vite": "vite --config app/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcmcneal/react-step-wizard.git"
  },
  "keywords": [
    "react",
    "step",
    "multistep",
    "wizard",
    "es6"
  ],
  "author": "Jason McNeal <jaywizard@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jcmcneal/react-step-wizard/issues"
  },
  "homepage": "https://github.com/jcmcneal/react-step-wizard#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "jsdom": "^29.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
