{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "react-step-wizard": [
        "./src/index.tsx"
      ]
    }
  },
  "include": [
    "src",
    "app",
    "tests",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
